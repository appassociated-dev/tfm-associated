// Schema tenant — DB-Tenant template (ADR-002)
// Este schema sirve como plantilla para las BDs de tenant.
// UC-001 ejecutará las migraciones en cada BD de tenant durante la provisión.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

/// Evento de outbox para comunicación cross-BC (ADR-008).
/// Cada BD de tenant necesita su propia tabla de outbox.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(200)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  processedAt DateTime? @map("processed_at") @db.Timestamptz()
  retryCount  Int       @default(0) @map("retry_count")
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz()
  lastError   String?   @map("last_error") @db.Text

  @@index([processedAt, retryCount, nextRetryAt])
  @@map("outbox_events")
}

/// Tipo de socio configurable por cada colectividad (UC-008).
model MemberType {
  id                           String    @id @default(uuid()) @db.Uuid
  code                         String    @unique @db.VarChar(10)
  name                         String    @db.VarChar(100)
  description                  String?   @db.Text
  ageRangeMin                  Int?      @map("age_range_min")
  ageRangeMax                  Int?      @map("age_range_max")
  votingRight                  Boolean   @default(false) @map("voting_right")
  eligibleForOffice            Boolean   @default(false) @map("eligible_for_office")
  minimumSeniorityForVoting    Int       @default(0) @map("minimum_seniority_for_voting")
  minimumSeniorityForOffice    Int       @default(0) @map("minimum_seniority_for_office")
  automaticTransitionTargetId  String?   @map("automatic_transition_target_id") @db.Uuid
  rulesConfig                  Json?     @map("rules_config")
  active                       Boolean   @default(true)
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  automaticTransitionTarget    MemberType?  @relation("AutoTransition", fields: [automaticTransitionTargetId], references: [id])
  transitionSources            MemberType[] @relation("AutoTransition")
  members                      Member[]

  @@map("member_types")
}

/// Ejercicio fiscal que agrupa temporalmente la actividad de la colectividad (UC-010).
model FiscalYear {
  id                      String    @id @default(uuid()) @db.Uuid
  name                    String    @unique @db.VarChar(100)
  type                    String    @db.VarChar(20)
  startDate               DateTime  @map("start_date") @db.Date
  endDate                 DateTime  @map("end_date") @db.Date
  status                  String    @default("PREPARATION") @db.VarChar(20)
  previousFiscalYearId    String?   @map("previous_fiscal_year_id") @db.Uuid
  membersAtStart          Int       @default(0) @map("members_at_start")
  membersAtEnd            Int?      @map("members_at_end")
  reportId                String?   @map("report_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at")
  closedAt                DateTime? @map("closed_at")

  previousFiscalYear      FiscalYear?  @relation("FiscalYearChain", fields: [previousFiscalYearId], references: [id])
  nextFiscalYears         FiscalYear[] @relation("FiscalYearChain")

  @@map("fiscal_years")
}

/// Socio de la colectividad con ficha completa (UC-006) y máquina de estados (UC-007).
model Member {
  id                String    @id @default(uuid()) @db.Uuid
  member_number     String    @unique @db.VarChar(20)
  name              String    @db.VarChar(100)
  surnames          String    @db.VarChar(200)
  birth_date        DateTime  @db.Date
  document_type     String    @db.VarChar(10)
  document_number   String    @unique @db.VarChar(20)
  email             String    @unique @db.VarChar(255)
  phone             String?   @db.VarChar(20)
  address           String?   @db.VarChar(300)
  postal_code       String?   @db.VarChar(10)
  city              String?   @db.VarChar(100)
  iban_encrypted    String?   @db.Text
  member_type_id    String    @db.Uuid
  custom_fields     Json?
  current_status    String    @default("APPLICANT") @db.VarChar(30)
  registration_date DateTime  @default(now())
  leave_date        DateTime?
  version           Int       @default(0)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  memberType        MemberType @relation(fields: [member_type_id], references: [id])

  @@index([current_status])
  @@index([member_type_id])
  @@index([email])
  @@map("members")
}

/// Historial de cambios de estado de un socio (UC-007).
/// INSERT-only: nunca se actualiza ni elimina un registro.
/// Sin FK formal a Member (decisión de diseño — repositorio propio).
model StatusHistory {
  id              String    @id @default(uuid()) @db.Uuid
  member_id       String    @db.Uuid
  previous_status String    @db.VarChar(30)
  new_status      String    @db.VarChar(30)
  reason          String    @db.VarChar(500)
  changed_by      String    @db.VarChar(100)
  changed_at      DateTime  @default(now())

  @@index([member_id])
  @@index([member_id, changed_at(sort: Desc)])
  @@map("status_history")
}
