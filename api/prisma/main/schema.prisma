// Schema principal — DB-Main (ADR-002)
// Gestiona: tenants, usuarios, membresías, roles, refresh tokens, outbox

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_MAIN_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client/main"
}

/// Tenant (asociación / colectividad). Cada tenant tiene su propia BD aislada.
model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(63)
  name         String   @db.VarChar(200)
  cif          String   @db.VarChar(20)
  type         String   @db.VarChar(50)
  status       String   @default("pending") @db.VarChar(20)
  databaseName String   @map("database_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  memberships TenantMembership[]

  @@map("tenants")
}

/// Usuario del sistema. Puede pertenecer a múltiples tenants.
model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  name           String    @db.VarChar(200)
  status         String    @default("active") @db.VarChar(20)
  failedAttempts Int       @default(0) @map("failed_attempts")
  blockedUntil   DateTime? @map("blocked_until") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastAccess     DateTime? @map("last_access") @db.Timestamptz()

  memberships   TenantMembership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Membresía de un usuario en un tenant con un rol asignado.
model TenantMembership {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  memberId   String?  @map("member_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()
  assignedBy String?  @map("assigned_by") @db.Uuid
  active     Boolean  @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, tenantId])
  @@map("tenant_memberships")
}

/// Rol con permisos. Puede ser de sistema (global) o de tenant.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  permissions Json    @default("[]")
  isSystem    Boolean @default(false) @map("is_system")
  tenantId    String? @map("tenant_id") @db.Uuid

  memberships TenantMembership[]

  @@unique([code, tenantId])
  @@map("roles")
}

/// Refresh token para renovación de sesiones JWT.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// Evento de outbox para comunicación cross-BC (ADR-008).
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(200)
  payload     Json
  tenantId    String?   @map("tenant_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  processedAt DateTime? @map("processed_at") @db.Timestamptz()
  retryCount  Int       @default(0) @map("retry_count")
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz()
  lastError   String?   @map("last_error") @db.Text

  @@index([processedAt, retryCount, nextRetryAt])
  @@map("outbox_events")
}
