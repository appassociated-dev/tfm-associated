# Base de datos — credenciales del contenedor PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Base de datos principal (BC-Identity)
DATABASE_MAIN_URL=postgresql://postgres:postgres@localhost:5432/associated_main

# Base de datos de tenant (se reemplaza en runtime por PrismaTenantService)
DATABASE_TENANT_URL=postgresql://postgres:postgres@localhost:5432/associated_tenant_example

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=associated

# Mailpit (mock SMTP en desarrollo)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@associated.local

# Observabilidad (vacío en desarrollo — usa ConsoleErrorReporter)
SENTRY_DSN=

# Puerto de la API
PORT=3000

# Entorno
NODE_ENV=development
