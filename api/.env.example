# ============================
# Associated API — Variables de entorno
# ============================
# Copiar este archivo a .env y ajustar los valores según el entorno.

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos principal (DB-Main) ---
# Contiene: tenants, users, roles, refresh_tokens, outbox_events
DATABASE_MAIN_URL=postgresql://associated:associated_dev@localhost:5432/associated_main?schema=public

# --- Base de datos de tenant (template) ---
# Se usa como plantilla. {tenantId} se reemplaza dinámicamente en runtime.
DATABASE_TENANT_URL=postgresql://associated:associated_dev@localhost:5432/tenant_{tenantId}?schema=public

# --- Pool de conexiones tenant ---
TENANT_POOL_MAX_SIZE=10
TENANT_POOL_EVICTION_MS=1800000

# --- JWT (ADR-006) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Observabilidad ---
# Dejar vacío en desarrollo. Configurar en staging/producción.
SENTRY_DSN=

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=associated

# --- Cifrado de datos sensibles (RNF-006) ---
# Clave AES-256: 64 caracteres hexadecimales (32 bytes).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- SMTP (Mailpit en desarrollo) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
