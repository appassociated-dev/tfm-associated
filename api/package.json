{
  "name": "associated-api",
  "version": "0.0.0",
  "private": true,
  "description": "Associated API — NestJS backend with DDD modular monolith",
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec \"node -r tsconfig-paths/register\"",
    "start:dev": "nest start --watch --exec \"node -r tsconfig-paths/register\"",
    "start:debug": "nest start --debug --watch --exec \"node -r tsconfig-paths/register\"",
    "start:prod": "node -r tsconfig-paths/register dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "prisma:generate:main": "prisma generate --config=prisma/main/prisma.config.ts",
    "prisma:generate:tenant": "prisma generate --config=prisma/tenant/prisma.config.ts",
    "prisma:generate": "npm run prisma:generate:main && npm run prisma:generate:tenant && npm run prisma:bridge",
    "prisma:bridge": "node scripts/generate-prisma-bridges.js",
    "prisma:migrate:main": "prisma migrate dev --config=prisma/main/prisma.config.ts",
    "prisma:migrate:tenant": "prisma migrate dev --config=prisma/tenant/prisma.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:cov": "vitest run --config vitest.config.ts --coverage",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sentry/nestjs": "^10.42.0",
    "argon2": "^0.41.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "date-fns": "^4.0.0",
    "passport-jwt": "^4.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^3.0.0",
    "dotenv": "^16.6.1",
    "prisma": "^7.4.2",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
