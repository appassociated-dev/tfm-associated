# =============================================================
# Associated API — Dockerfile de produccion (multi-stage)
#
# Etapas:
#   1. deps     — Instala dependencias de produccion + genera Prisma
#   2. build    — Compila TypeScript con nest build
#   3. production — Imagen final slim con artefactos minimos
#
# Build context: raiz del monorepo (../)
# Uso: docker build -f api/Dockerfile.prod -t associated-api .
# =============================================================

# ---- Etapa 1: Dependencias ----
FROM node:22-slim AS deps

WORKDIR /app

# Copiar archivos de dependencias del monorepo
COPY package.json package-lock.json ./
COPY api/package.json ./api/

# Instalar TODAS las dependencias (necesarias para build)
# --ignore-scripts evita ejecutar husky prepare dentro de Docker
RUN npm ci --workspace=api --ignore-scripts

# Copiar schemas de Prisma y script de bridges
COPY api/prisma ./api/prisma
COPY api/scripts/generate-prisma-bridges.js ./api/scripts/

# Instalar openssl (requerido por Prisma engine)
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# Generar clientes Prisma + CJS bridges
# Variables dummy — prisma generate solo necesita que existan, no conecta a la DB
ENV DATABASE_MAIN_URL="postgresql://dummy:dummy@localhost:5432/dummy?schema=public"
ENV DATABASE_TENANT_URL="postgresql://dummy:dummy@localhost:5432/dummy?schema=public"
RUN npm run --workspace=api prisma:generate

# ---- Etapa 2: Build ----
FROM deps AS build

WORKDIR /app

# Copiar codigo fuente del API
COPY api/src ./api/src
COPY api/tsconfig.json api/tsconfig.build.json api/nest-cli.json ./api/

# Compilar TypeScript
RUN npm run --workspace=api build

# ---- Etapa 3: Produccion ----
FROM node:22-slim AS production

# Instalar tini (init process) y postgresql-client (~5MB, necesario para migrate-tenants.sh)
RUN apt-get update && \
    apt-get install -y --no-install-recommends tini postgresql-client curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar archivos de dependencias del monorepo
COPY package.json package-lock.json ./
COPY api/package.json ./api/

# Instalar solo dependencias de produccion
# --ignore-scripts evita ejecutar husky prepare dentro de Docker
RUN npm ci --workspace=api --omit=dev --ignore-scripts

# Copiar artefactos de build
COPY --from=build /app/api/dist ./api/dist

# Copiar schemas + migraciones + clientes generados de Prisma
COPY --from=deps /app/api/prisma ./api/prisma

# Copiar scripts necesarios en runtime
COPY api/scripts/generate-prisma-bridges.js ./api/scripts/
COPY scripts/migrate-tenants.sh ./scripts/

# Copiar tsconfig.json (necesario para tsconfig-paths en runtime)
COPY api/tsconfig.json ./api/

# Asegurar que el script de migracion es ejecutable
RUN chmod +x ./scripts/migrate-tenants.sh

# Dar permisos al directorio de engines de Prisma (npx prisma migrate deploy necesita escribir ahi)
RUN chmod -R 777 ./node_modules/@prisma/engines || true

# Crear usuario no-root para seguridad
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/sh --create-home appuser

USER appuser

ENV NODE_ENV=production
ENV PORT=3000
ENV TS_NODE_PROJECT=/app/api/tsconfig.json

EXPOSE 3000

# Health check del contenedor
HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=30s \
  CMD curl -f http://localhost:3000/api/v1/health || exit 1

# Usar tini como init process para manejo correcto de senales
ENTRYPOINT ["tini", "--"]

# Iniciar la aplicacion con resolucion de path aliases
CMD ["node", "-r", "tsconfig-paths/register", "api/dist/main"]
