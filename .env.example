# =============================================================================
# Associated — Variables de entorno para desarrollo local
# Copiar a .env y ajustar valores según necesidad
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=associated
POSTGRES_PASSWORD=associated_dev
POSTGRES_DB=associated_main
POSTGRES_PORT=5432

# Cadena de conexión para Prisma (API)
DATABASE_URL=postgresql://associated:associated_dev@localhost:5432/associated_main?schema=public

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=associated
MINIO_ROOT_PASSWORD=associated_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000

# --- Mailpit (SMTP mock) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# --- API (NestJS) ---
API_PORT=3000
NODE_ENV=development

# --- JWT ---
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=1h

# --- Sentry (observabilidad) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
