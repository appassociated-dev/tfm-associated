# =============================================================
# Associated Web — Dockerfile de produccion (multi-stage)
#
# Etapas:
#   1. build      — Instala dependencias, compila con Vite
#   2. production — Sirve assets estaticos con nginx:alpine
#
# Build context: raiz del monorepo (../)
# Uso: docker build -f web/Dockerfile.prod -t associated-web .
# =============================================================

# ---- Etapa 1: Build ----
FROM node:22-slim AS build

WORKDIR /app

# Variable de build para la URL del API (inyectada en el bundle)
ARG VITE_API_URL=/api

# Copiar archivos de dependencias del monorepo
COPY package.json package-lock.json ./
COPY web/package.json ./web/

# Instalar dependencias
RUN npm ci --workspace=web

# Copiar codigo fuente del frontend
COPY web/src ./web/src
COPY web/public ./web/public
COPY web/index.html ./web/
COPY web/tsconfig.json web/tsconfig.node.json ./web/
COPY web/vite.config.ts ./web/
COPY web/postcss.config.cjs ./web/

# Compilar TypeScript y generar bundle de produccion
RUN cd web && npx tsc -b && npx vite build

# ---- Etapa 2: Produccion ----
FROM nginx:1.27-alpine AS production

# Copiar configuracion nginx para SPA
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar assets estaticos del build
COPY --from=build /app/web/dist /usr/share/nginx/html

# Instalar curl para healthcheck
RUN apk add --no-cache curl

EXPOSE 8080

# Ejecutar como usuario no-root para seguridad
USER nginx

# Health check del contenedor
HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=10s \
  CMD curl -f http://localhost:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
