# =============================================================================
# Associated — Variables de entorno para PRODUCCION
#
# Copiar a .env en el VPS y completar con valores reales.
# NUNCA commitear el archivo .env con valores reales.
#
# Uso: docker compose -f docker-compose.prod.yml --env-file .env up -d
# =============================================================================

# --- Entorno ---
# Modo de ejecucion de Node.js (no cambiar)
NODE_ENV=production

# --- Dominio ---
# Dominio publico del servidor (usado en nginx y CORS)
DOMAIN=asociacion.example.com

# --- PostgreSQL ---
# Usuario de la base de datos
POSTGRES_USER=associated

# Contrasena de la base de datos (CAMBIAR — usar un valor aleatorio seguro)
POSTGRES_PASSWORD=CAMBIAR_por_contrasena_segura

# Nombre de la base de datos principal
POSTGRES_DB=associated_main

# --- Conexion a la base de datos (Prisma) ---
# URL de conexion a la base de datos principal
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_DB?schema=public
# En Docker el host es el nombre del servicio (postgres)
DATABASE_MAIN_URL=postgresql://associated:CAMBIAR_por_contrasena_segura@postgres:5432/associated_main?schema=public

# URL plantilla para bases de datos de tenant
# El nombre de la DB se reemplaza dinamicamente en runtime
DATABASE_TENANT_URL=postgresql://associated:CAMBIAR_por_contrasena_segura@postgres:5432/tenant_placeholder?schema=public

# --- API (NestJS) ---
# Puerto interno del contenedor API (no cambiar salvo necesidad)
API_PORT=3000

# --- Seguridad: JWT ---
# Secreto para firmar tokens JWT (CAMBIAR — minimo 32 caracteres aleatorios)
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_por_secreto_jwt_aleatorio

# Tiempo de expiracion de tokens JWT
JWT_EXPIRES_IN=1h

# --- Seguridad: Cifrado de datos personales ---
# Clave AES-256 para cifrar IBAN, DNI, etc. (CAMBIAR — exactamente 64 caracteres hexadecimales)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=CAMBIAR_por_clave_hex_64_caracteres

# --- Seguridad: API Key de superadmin ---
# Clave para operaciones de superadmin (provisionamiento de tenants)
# Generar con: openssl rand -base64 32
SUPERADMIN_API_KEY=CAMBIAR_por_api_key_superadmin

# --- Pool de conexiones de tenant ---
# Maximo de conexiones simultaneas a bases de datos de tenant (opcional)
# TENANT_POOL_MAX_SIZE=10

# Tiempo (ms) antes de desconectar un tenant inactivo (opcional)
# TENANT_POOL_EVICTION_MS=300000

# --- Observabilidad: Sentry (opcional) ---
# DSN de Sentry para monitoreo de errores. Dejar vacio para deshabilitar.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# --- GHCR (GitHub Container Registry) ---
# Estas variables NO se usan en docker compose; son para scripts/deploy.sh
# GHCR_USER=tu-usuario-github
# GHCR_TOKEN=ghp_xxxxxxxxxxxx (Personal Access Token con permisos write:packages)
